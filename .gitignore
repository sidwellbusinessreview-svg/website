# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/.playwright/
/junit.xml
/.sanity-reports/
/.sanity/
/dist/

# next.js
/.next/
/out/

# production
/build
/dist/
/.sanity/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files; the documented placeholder file is intentionally tracked
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# operating systems and editors
Thumbs.db
Desktop.ini
._*
.idea/
.vscode/
# Supplied source evidence is maintained outside Git; CI tests use synthetic temporary fixtures.
migration-input/
# Generated migration staging, review reports, and approvals are maintained outside Git.
migration-staging/
/migration-backups/
