{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "CONTENT_SOURCE=local playwright test",
    "test:e2e:sanity": "CONTENT_SOURCE=sanity playwright test tests/e2e/sanity-provider.spec.ts",
    "test:e2e:ui": "CONTENT_SOURCE=local playwright test --ui",
    "sanity:check": "node --import tsx scripts/check-sanity.ts",
    "sanity:check-provider": "node --import tsx scripts/check-content-provider.ts",
    "sanity:diagnose-preview": "node --import tsx scripts/diagnose-preview-provider.ts",
    "sanity:migration:validate": "node --import tsx scripts/migration/sbr-archive.ts --validate",
    "sanity:migration:dry-run": "node --import tsx scripts/migration/sbr-archive.ts --dry-run",
    "sanity:migration:apply": "node --import tsx scripts/migration/sbr-archive.ts --apply",
    "sanity:migration:report": "node --import tsx scripts/migration/sbr-archive.ts --report",
    "sanity:migration:rollback": "node --import tsx scripts/migration/sbr-archive.ts --rollback",
    "sanity:migration:rollback:apply": "node --import tsx scripts/migration/sbr-archive.ts --rollback --rollback-apply",
    "sanity:check-cache": "node --import tsx scripts/check-sanity-cache.ts",
    "sanity:check-target": "node --import tsx scripts/check-sanity-target.ts",
    "sanity:schema": "sanity schema extract --enforce-required-fields --force",
    "sanity:typegen": "npm run sanity:schema && sanity typegen generate",
    "sanity:audit-content": "sanity exec scripts/sanity/audit-content.ts --with-user-token",
    "sanity:audit-content:published": "SANITY_AUDIT_PUBLISHED_ONLY=1 sanity exec scripts/sanity/audit-content.ts",
    "sanity:audit-singletons": "npm run sanity:audit-pages",
    "sanity:audit-pages": "sanity exec scripts/sanity/audit-singletons.ts --with-user-token",
    "sanity:audit-pages:published": "SANITY_AUDIT_PUBLISHED_ONLY=1 sanity exec scripts/sanity/audit-singletons.ts",
    "sanity:audit-pages:ci": "SANITY_AUDIT_CI=1 sanity exec scripts/sanity/audit-singletons.ts",
    "sanity:audit-contributors": "sanity exec scripts/sanity/audit-malformed-contributors.ts --with-user-token",
    "sanity:cleanup-legacy": "sanity exec scripts/sanity/cleanup-legacy.ts --with-user-token",
    "sanity:cleanup-fields": "sanity exec scripts/sanity/cleanup-obsolete-fields.ts --with-user-token",
    "sanity:cleanup-contributor-roles": "sanity exec scripts/sanity/cleanup-contributor-roles.ts --with-user-token",
    "sanity:cleanup-contributor-roles:apply": "sanity exec scripts/sanity/cleanup-contributor-roles.ts --with-user-token -- --apply",
    "sanity:reset-test-content": "sanity exec scripts/sanity/reset-test-content.ts --with-user-token",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "verify": "npm run lint && npm run typecheck && npm run validate:content && npm run test && npm run build"
  },
  "dependencies": {
    "@portabletext/block-tools": "5.1.10",
    "@sanity/icons": "5.2.1",
    "@sanity/id-utils": "^1.0.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "4.1.1",
    "@sanity/ui": "^3.3.5",
    "@sanity/vision": "^6.5.0",
    "next": "16.2.10",
    "next-sanity": "^13.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.5.0",
    "styled-components": "^6.1.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
