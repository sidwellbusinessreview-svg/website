# Public Sanity project identifier shown in sanity.io/manage. Not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Public Sanity dataset name. This project currently uses production in every environment.
NEXT_PUBLIC_SANITY_DATASET=

# Sanity API date in YYYY-MM-DD format, pinned when the integration is configured.
NEXT_PUBLIC_SANITY_API_VERSION=

# Standalone Studio origin used by Visual Editing links and overlays.
# Use localhost for local Studio development, then replace it with the chosen
# *.sanity.studio URL in the public deployment after the first Studio deploy.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Standalone Studio Presentation target. Sanity Studio exposes only variables
# prefixed SANITY_STUDIO_ to its browser bundle. This is a public origin, not a secret.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Server-only Viewer token used to validate Preview requests and read drafts.
# Never prefix this name with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Server-only Editor token used only by explicitly invoked migration apply/rollback commands.
SANITY_API_WRITE_TOKEN=

# Server-only fallback secret for direct Preview links. Use a long random value.
# Presentation Tool normally uses Sanity's expiring preview URL secrets.
SANITY_PREVIEW_SECRET=

# Server-only secret used by the fixed-tag revalidation endpoint. Hosted webhook setup is deferred.
SANITY_REVALIDATE_SECRET=

# Canonical public site origin, such as the production domain. Leave blank for local development.
NEXT_PUBLIC_SITE_URL=
# Temporary provider switch. Keep local until Phase 12 migration acceptance;
# use sanity only when the public Sanity variables below are configured.
CONTENT_SOURCE=local

# Optional Playwright CMS fixture overrides. Leave blank to use the documented
# canonical Phase 12 defaults. These are public test labels/slugs, not credentials.
CMS_TEST_ARTICLE_TITLE=
CMS_TEST_ARTICLE_SLUG=
CMS_TEST_CONTRIBUTOR_NAME=
CMS_TEST_CONTRIBUTOR_SLUG=
