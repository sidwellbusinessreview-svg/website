# Public Sanity project identifier. Not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=bumxf5q6

# Public Sanity dataset name. This project uses production for public reads and Studio.
NEXT_PUBLIC_SANITY_DATASET=production

# Pinned Sanity API date in YYYY-MM-DD format.
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01

# Standalone Studio origin used by Visual Editing links and overlays.
# Use localhost for local Studio development. Production uses
# https://sidwell-business-review.sanity.studio.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Standalone Studio Presentation target. Sanity Studio exposes only variables
# prefixed SANITY_STUDIO_ to its browser bundle. This is a public origin, not a secret.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Server-only Viewer token used to validate Preview requests and read drafts.
# Never prefix this name with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Server-only Editor token used only by explicitly invoked migration apply/rollback commands.
SANITY_API_WRITE_TOKEN=

# Server-only fallback secret for direct Preview links. Use a long random value.
# Presentation Tool normally uses Sanity's expiring preview URL secrets.
SANITY_PREVIEW_SECRET=

# Server-only secret shared by the fixed-tag endpoint and configured production webhook.
SANITY_REVALIDATE_SECRET=

# Canonical site origin. Leave blank for the http://localhost:3000 fallback.
# Production uses https://website.sidwellbusinessreview.workers.dev.
NEXT_PUBLIC_SITE_URL=
# Explicit provider switch. Local development uses fixtures by default;
# production must use sanity. Changing the hosted value requires a rebuild.
CONTENT_SOURCE=local

# Optional Playwright CMS fixture overrides. These are public test labels/slugs,
# not credentials; keep blank unless the current CMS test fixture is documented.
CMS_TEST_ARTICLE_TITLE=
CMS_TEST_ARTICLE_SLUG=
CMS_TEST_CONTRIBUTOR_NAME=
CMS_TEST_CONTRIBUTOR_SLUG=
