# Public Sanity project identifier. Unused until the CMS integration phases.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Public Sanity dataset name. Unused until the CMS integration phases.
NEXT_PUBLIC_SANITY_DATASET=

# Sanity API date used to make content queries reproducible. Unused until the CMS integration phases.
NEXT_PUBLIC_SANITY_API_VERSION=

# Read-only server token for protected CMS content. Unused until the CMS integration phases.
SANITY_API_READ_TOKEN=

# Secret used to validate draft-preview requests. Unused until preview support is implemented.
SANITY_PREVIEW_SECRET=

# Secret used to validate CMS revalidation webhooks. Unused until CMS publishing is implemented.
SANITY_REVALIDATE_SECRET=

# Canonical public site origin, such as the production domain. Leave blank for local development.
NEXT_PUBLIC_SITE_URL=
