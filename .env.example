# Public Sanity project identifier shown in sanity.io/manage. Not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Public Sanity dataset name, normally development locally and production when deployed.
NEXT_PUBLIC_SANITY_DATASET=

# Sanity API date in YYYY-MM-DD format, pinned when the integration is configured.
NEXT_PUBLIC_SANITY_API_VERSION=

# Embedded Studio route. Keep this aligned with the application route.
NEXT_PUBLIC_SANITY_STUDIO_BASE_PATH=/studio

# Read-only server token reserved for authenticated draft preview in a later phase.
SANITY_API_READ_TOKEN=

# Secret used to validate draft-preview requests. Unused until preview support is implemented.
SANITY_PREVIEW_SECRET=

# Secret used to validate CMS revalidation webhooks. Unused until CMS publishing is implemented.
SANITY_REVALIDATE_SECRET=

# Canonical public site origin, such as the production domain. Leave blank for local development.
NEXT_PUBLIC_SITE_URL=
